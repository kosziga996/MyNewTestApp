---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Admin - TechConf 2026">
	<div class="container">
		<div class="page-header animate-in">
			<div class="admin-badge">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
				Admin
			</div>
			<h1>Dashboard</h1>
			<p class="page-desc">Manage sessions, speakers, and review feedback</p>
		</div>

		<div class="admin-layout">
			<aside class="sidebar animate-in" style="animation-delay:0.1s">
				<button class="sidebar-btn active" data-tab="sessions">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
					Sessions
				</button>
				<button class="sidebar-btn" data-tab="feedback">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
					Feedback
				</button>
				<button class="sidebar-btn" data-tab="add-session">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
					Add Session
				</button>
			</aside>

			<main class="admin-main animate-in" style="animation-delay:0.15s">
				<!-- Sessions Tab -->
				<div class="tab-content active" id="tab-sessions">
					<div class="tab-title">
						<h2>All Sessions</h2>
						<span class="count-badge" id="session-count">0</span>
					</div>
					<div class="table-card">
						<div class="table-scroll">
							<table>
								<thead>
									<tr>
										<th>Session</th>
										<th>Speaker</th>
										<th>Schedule</th>
										<th>Location</th>
										<th></th>
									</tr>
								</thead>
								<tbody id="sessions-tbody"></tbody>
							</table>
						</div>
					</div>
				</div>

				<!-- Feedback Tab -->
				<div class="tab-content" id="tab-feedback">
					<div class="tab-title"><h2>Feedback Overview</h2></div>
					<div class="stats-row" id="feedback-stats"></div>
					<div id="admin-feedback-list"></div>
					<div class="empty-state" id="admin-empty-fb">
						<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
						<p>No feedback received yet</p>
					</div>
				</div>

				<!-- Add Session Tab -->
				<div class="tab-content" id="tab-add-session">
					<div class="tab-title"><h2>Add New Session</h2></div>
					<div class="add-form">
						<div class="form-row">
							<div class="form-group">
								<label>Title</label>
								<input type="text" id="new-title" placeholder="Session title" />
							</div>
							<div class="form-group">
								<label>Speaker</label>
								<input type="text" id="new-speaker" placeholder="Speaker name" />
							</div>
						</div>
						<div class="form-row">
							<div class="form-group">
								<label>Time</label>
								<input type="text" id="new-time" placeholder="e.g. 09:00" />
							</div>
							<div class="form-group">
								<label>Day</label>
								<div class="select-wrap">
									<select id="new-day">
										<option value="Day 1">Day 1 - May 25</option>
										<option value="Day 2">Day 2 - May 26</option>
										<option value="Day 3">Day 3 - May 27</option>
									</select>
									<svg class="select-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
								</div>
							</div>
						</div>
						<div class="form-row">
							<div class="form-group">
								<label>Location</label>
								<div class="select-wrap">
									<select id="new-location">
										<option>Main Hall A</option>
										<option>Room 201</option>
										<option>Room 302</option>
										<option>Workshop Lab</option>
									</select>
									<svg class="select-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
								</div>
							</div>
							<div class="form-group">
								<label>Track</label>
								<div class="select-wrap">
									<select id="new-track">
										<option>Web</option>
										<option>AI</option>
										<option>Cloud</option>
										<option>General</option>
									</select>
									<svg class="select-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
								</div>
							</div>
						</div>
						<button class="btn" id="add-session-btn">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
							Add Session
						</button>
						<span id="add-msg" class="add-msg"></span>
					</div>
				</div>
			</main>
		</div>
	</div>
</Layout>

<style>
	.admin-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.3rem 0.9rem;
		background: rgba(99,102,241,0.12);
		color: var(--accent);
		border-radius: 9999px;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		margin-bottom: 0.75rem;
	}
	.admin-layout {
		display: grid;
		grid-template-columns: 220px 1fr;
		gap: 2rem;
		align-items: start;
	}
	/* Sidebar */
	.sidebar {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		position: sticky;
		top: 80px;
	}
	.sidebar-btn {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		padding: 0.7rem 1rem;
		background: transparent;
		border: 1px solid transparent;
		border-radius: var(--radius-sm);
		color: var(--text-muted);
		font-size: 0.9rem;
		font-weight: 500;
		font-family: inherit;
		cursor: pointer;
		text-align: left;
		transition: all 0.2s ease;
	}
	.sidebar-btn:hover {
		color: var(--text);
		background: rgba(255,255,255,0.04);
	}
	.sidebar-btn.active {
		color: white;
		background: var(--bg-card);
		border-color: var(--border);
	}

	/* Main */
	.admin-main {
		min-width: 0;
	}
	.tab-content { display: none; }
	.tab-content.active { display: block; animation: fadeIn 0.3s ease; }
	.tab-title {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1.25rem;
	}
	.tab-title h2 { margin: 0; }
	.count-badge {
		background: var(--accent-glow);
		color: var(--accent);
		font-weight: 700;
		font-size: 0.75rem;
		padding: 0.2rem 0.6rem;
		border-radius: 9999px;
	}

	/* Table */
	.table-card {
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
	}
	.table-scroll { overflow-x: auto; }
	table {
		width: 100%;
		border-collapse: collapse;
	}
	th {
		text-align: left;
		padding: 0.85rem 1.25rem;
		font-size: 0.72rem;
		font-weight: 700;
		color: var(--text-dim);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		border-bottom: 1px solid var(--border);
		white-space: nowrap;
	}
	td {
		padding: 0.85rem 1.25rem;
		font-size: 0.88rem;
		border-bottom: 1px solid rgba(255,255,255,0.03);
		vertical-align: middle;
	}
	tr:hover td { background: rgba(255,255,255,0.02); }
	.cell-title { font-weight: 600; color: white; }
	.cell-sub { font-size: 0.75rem; color: var(--text-dim); margin-top: 0.15rem; }
	.btn-del {
		padding: 0.35rem 0.75rem;
		font-size: 0.75rem;
		font-weight: 600;
		border-radius: var(--radius-xs);
		border: 1px solid rgba(248,113,113,0.2);
		background: rgba(248,113,113,0.08);
		color: var(--red);
		cursor: pointer;
		font-family: inherit;
		transition: all 0.2s;
	}
	.btn-del:hover { background: rgba(248,113,113,0.15); }

	/* Stats */
	.stats-row {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
		margin-bottom: 1.5rem;
	}
	.stat-box {
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.25rem;
		text-align: center;
	}
	.stat-box-num {
		font-size: 2rem;
		font-weight: 900;
		letter-spacing: -0.03em;
	}
	.stat-box-num.purple { color: var(--accent); }
	.stat-box-num.amber { color: var(--amber); }
	.stat-box-num.green { color: var(--green); }
	.stat-box-label { color: var(--text-dim); font-size: 0.8rem; font-weight: 500; margin-top: 0.15rem; }

	/* Admin feedback cards */
	.admin-fb-item {
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.15rem;
		margin-bottom: 0.65rem;
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 1rem;
		transition: all 0.25s;
	}
	.admin-fb-item:hover { border-color: var(--border-hover); }

	/* Form */
	.add-form {
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 2rem;
	}
	.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
	.form-group { margin-bottom: 1.25rem; }
	.form-group label {
		display: block;
		font-weight: 600;
		font-size: 0.82rem;
		margin-bottom: 0.4rem;
		color: var(--text);
	}
	.select-wrap { position: relative; }
	.select-chevron {
		position: absolute;
		right: 12px;
		top: 50%;
		transform: translateY(-50%);
		color: var(--text-dim);
		pointer-events: none;
	}
	select, input {
		width: 100%;
		padding: 0.65rem 1rem;
		background: rgba(255,255,255,0.04);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		color: var(--text);
		font-size: 0.9rem;
		font-family: inherit;
		transition: all 0.2s;
		-webkit-appearance: none;
		appearance: none;
	}
	select { padding-right: 2.5rem; cursor: pointer; }
	select option { background: #1a1a2e; color: var(--text); }
	input::placeholder { color: var(--text-dim); }
	select:focus, input:focus {
		outline: none;
		border-color: var(--accent);
		box-shadow: 0 0 0 3px var(--accent-glow);
	}
	.add-msg {
		margin-left: 1rem;
		font-weight: 600;
		font-size: 0.85rem;
	}
	.empty-state {
		text-align: center;
		padding: 3rem 1rem;
		color: var(--text-dim);
	}
	.empty-state svg { margin-bottom: 0.75rem; opacity: 0.3; }
	.empty-state p { font-weight: 600; color: var(--text-muted); }

	@media (max-width: 768px) {
		.admin-layout { grid-template-columns: 1fr; }
		.sidebar {
			flex-direction: row;
			overflow-x: auto;
			position: static;
		}
		.sidebar-btn { white-space: nowrap; }
		.form-row { grid-template-columns: 1fr; }
		.stats-row { grid-template-columns: 1fr; }
	}
</style>

<script>
	// Tab switching
	document.querySelectorAll('.sidebar-btn').forEach(btn => {
		btn.addEventListener('click', () => {
			document.querySelectorAll('.sidebar-btn').forEach(b => b.classList.remove('active'));
			document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
			btn.classList.add('active');
			document.getElementById(`tab-${btn.getAttribute('data-tab')}`)!.classList.add('active');
		});
	});

	interface Session {
		id: number; title: string; speaker: string; time: string; day: string; location: string; track: string;
	}

	const defaultSessions: Session[] = [
		{ id: 1, title: 'Opening Keynote: The Future of Web', speaker: 'Jane Smith', time: '09:00', day: 'Day 1', location: 'Main Hall A', track: 'General' },
		{ id: 2, title: 'Building with Astro 6', speaker: 'Alex Chen', time: '10:30', day: 'Day 1', location: 'Room 201', track: 'Web' },
		{ id: 3, title: 'Intro to AI Agents', speaker: 'Maria Lopez', time: '10:30', day: 'Day 1', location: 'Room 302', track: 'AI' },
		{ id: 4, title: 'TypeScript Best Practices', speaker: 'David Kim', time: '13:00', day: 'Day 1', location: 'Room 201', track: 'Web' },
		{ id: 5, title: 'Cloud Native Architecture', speaker: 'Sarah Johnson', time: '13:00', day: 'Day 1', location: 'Workshop Lab', track: 'Cloud' },
		{ id: 6, title: 'React Server Components Deep Dive', speaker: 'Lisa Park', time: '10:30', day: 'Day 2', location: 'Room 201', track: 'Web' },
		{ id: 7, title: 'MLOps for Teams', speaker: 'James Obi', time: '10:30', day: 'Day 2', location: 'Room 302', track: 'AI' },
		{ id: 8, title: 'CSS Container Queries Workshop', speaker: 'Nina Patel', time: '13:00', day: 'Day 2', location: 'Workshop Lab', track: 'Web' },
		{ id: 9, title: 'Edge Computing & the Modern Web', speaker: 'Mark Davis', time: '09:00', day: 'Day 3', location: 'Main Hall A', track: 'Cloud' },
		{ id: 10, title: 'Building Accessible UIs', speaker: 'Rachel Green', time: '10:30', day: 'Day 3', location: 'Room 201', track: 'Web' },
		{ id: 11, title: 'Hands-on: Full-Stack with Astro', speaker: 'Alex Chen', time: '13:00', day: 'Day 3', location: 'Workshop Lab', track: 'Web' },
		{ id: 12, title: 'Closing Keynote & Awards', speaker: 'Jane Smith', time: '15:00', day: 'Day 3', location: 'Main Hall A', track: 'General' },
	];

	const trackColors: Record<string, string> = {
		General: '#818cf8', Web: '#22d3ee', AI: '#e879f9', Cloud: '#34d399'
	};

	function getSessions(): Session[] {
		const stored = localStorage.getItem('conf-sessions');
		return stored ? JSON.parse(stored) : defaultSessions;
	}
	function saveSessions(s: Session[]) { localStorage.setItem('conf-sessions', JSON.stringify(s)); }

	function renderSessions() {
		const sessions = getSessions();
		document.getElementById('session-count')!.textContent = String(sessions.length);
		const tbody = document.getElementById('sessions-tbody')!;
		tbody.innerHTML = sessions.map(s => `
			<tr>
				<td>
					<div class="cell-title">${s.title}</div>
					<div class="cell-sub" style="display:flex;gap:0.5rem;align-items:center">
						<span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:${trackColors[s.track] || '#818cf8'}"></span>
						${s.track}
					</div>
				</td>
				<td style="color:var(--text-muted)">${s.speaker}</td>
				<td style="color:var(--text-muted);white-space:nowrap">${s.day} &middot; ${s.time}</td>
				<td style="color:var(--text-muted)">${s.location}</td>
				<td><button class="btn-del" onclick="deleteSession(${s.id})">Delete</button></td>
			</tr>
		`).join('');
	}

	(window as any).deleteSession = (id: number) => {
		if (!confirm('Delete this session?')) return;
		saveSessions(getSessions().filter(s => s.id !== id));
		renderSessions();
	};

	interface Feedback {
		session: string; rating: number; text: string; name: string; date: string;
	}
	function getFeedbacks(): Feedback[] {
		return JSON.parse(localStorage.getItem('conf-feedbacks') || '[]');
	}

	function renderAdminFeedback() {
		const feedbacks = getFeedbacks();
		const statsEl = document.getElementById('feedback-stats')!;
		const listEl = document.getElementById('admin-feedback-list')!;
		const emptyEl = document.getElementById('admin-empty-fb')!;

		if (feedbacks.length === 0) {
			statsEl.innerHTML = '';
			listEl.innerHTML = '';
			emptyEl.style.display = '';
			return;
		}
		emptyEl.style.display = 'none';
		const avg = (feedbacks.reduce((sum, f) => sum + f.rating, 0) / feedbacks.length).toFixed(1);
		const fiveStars = feedbacks.filter(f => f.rating === 5).length;
		statsEl.innerHTML = `
			<div class="stat-box"><div class="stat-box-num purple">${feedbacks.length}</div><div class="stat-box-label">Total Reviews</div></div>
			<div class="stat-box"><div class="stat-box-num amber">${avg}</div><div class="stat-box-label">Avg Rating</div></div>
			<div class="stat-box"><div class="stat-box-num green">${fiveStars}</div><div class="stat-box-label">5-Star Reviews</div></div>
		`;
		listEl.innerHTML = feedbacks.slice().reverse().map(fb => `
			<div class="admin-fb-item">
				<div style="flex:1;min-width:0">
					<h4 style="font-size:0.9rem;font-weight:700;color:white;margin:0 0 0.25rem">${fb.session.split(' - ')[0]}</h4>
					<p style="color:var(--text-muted);font-size:0.83rem;margin:0">${fb.text || '<span style="color:var(--text-dim);font-style:italic">No comment</span>'}</p>
					<p style="color:var(--text-dim);font-size:0.72rem;margin:0.35rem 0 0">${fb.name} &middot; ${fb.date}</p>
				</div>
				<span style="color:#fbbf24;white-space:nowrap;font-size:0.95rem">${'★'.repeat(fb.rating)}${'<span style="color:rgba(255,255,255,0.08)">★</span>'.repeat(5 - fb.rating)}</span>
			</div>
		`).join('');
	}

	document.getElementById('add-session-btn')!.addEventListener('click', () => {
		const title = (document.getElementById('new-title') as HTMLInputElement).value.trim();
		const speaker = (document.getElementById('new-speaker') as HTMLInputElement).value.trim();
		const time = (document.getElementById('new-time') as HTMLInputElement).value.trim();
		const day = (document.getElementById('new-day') as HTMLSelectElement).value;
		const location = (document.getElementById('new-location') as HTMLSelectElement).value;
		const track = (document.getElementById('new-track') as HTMLSelectElement).value;
		const msg = document.getElementById('add-msg')!;

		if (!title || !speaker || !time) {
			msg.textContent = 'Please fill in title, speaker, and time';
			msg.style.color = 'var(--red)';
			return;
		}

		const sessions = getSessions();
		const id = Math.max(0, ...sessions.map(s => s.id)) + 1;
		sessions.push({ id, title, speaker, time, day, location, track });
		saveSessions(sessions);

		(document.getElementById('new-title') as HTMLInputElement).value = '';
		(document.getElementById('new-speaker') as HTMLInputElement).value = '';
		(document.getElementById('new-time') as HTMLInputElement).value = '';

		msg.textContent = 'Session added successfully!';
		msg.style.color = 'var(--green)';
		setTimeout(() => { msg.textContent = ''; }, 3000);

		renderSessions();
	});

	renderSessions();
	renderAdminFeedback();
</script>
